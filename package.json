{
  "name": "vyra",
  "version": "0.1.0",
  "private": true,
  "description": "VYRA — platforma treningowa dla trenera i zawodników (Next.js + Supabase).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
