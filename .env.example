# Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Public "anon" (or "publishable") key. Safe in the browser: every query is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public address of the app, used in invitation and password-reset links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The app never needs the service-role key. Do not add it here.

# Optional: end-to-end tests (see README)
# E2E_BASE_URL=http://localhost:3000
# E2E_COACH_EMAIL=
# E2E_COACH_PASSWORD=
# E2E_ATHLETE_EMAIL=
# E2E_ATHLETE_PASSWORD=
